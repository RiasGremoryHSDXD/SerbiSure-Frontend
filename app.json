{
  "expo": {
    "name": "SerbiSure",
    "slug": "serbisure-frontend",
    "version": "0.1.2",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/serbisure_new_clean.png",
    "splash": {
      "image": "./assets/serbisure_new_clean.png",
      "resizeMode": "contain",
      "backgroundColor": "#05070A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "SerbiSure needs camera access for liveness detection."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SerbiSure needs access to your photos to upload documents.",
          "cameraPermission": "SerbiSure needs camera access to take document photos."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.serbisure.frontend",
      "infoPlist": {
        "NSCameraUsageDescription": "SerbiSure needs camera access for liveness detection."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/serbisure_new_clean.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.serbisure.frontend"
    },
    "extra": {
      "eas": {
        "projectId": "2285d21a-6154-4ab6-84c9-bed6c4af2ce5"
      }
    },
    "owner": "riasgremory"
  }
}