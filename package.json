{
  "name": "serbisure-frontend",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry.js",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "android:build": "powershell -ExecutionPolicy Bypass -File ./scripts/android-build.ps1",
    "android:build:debug": "powershell -ExecutionPolicy Bypass -File ./scripts/android-build-debug.ps1",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "admin": "npm --prefix admin run dev",
    "admin:build": "npm --prefix admin run build"
  },
  "dependencies": {
    "@shopify/react-native-skia": "^1.5.0",
    "expo": "^51.0.0",
    "expo-dev-client": "^4.0.0",
    "expo-document-picker": "~12.0.2",
    "expo-image-picker": "~15.1.0",
    "expo-status-bar": "^1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-mediapipe": "^0.6.0",
    "react-native-reanimated": "3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-vision-camera": "4.5.0",
    "react-native-vision-camera-face-detector": "1.10.2",
    "react-native-worklets-core": "^1.3.3",
    "vision-camera-resize-plugin": "^3.1.0"
  },
  "overrides": {
    "react-native": "$react-native"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  }
}
